rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar: Verifica que el usuario sea personal institucional autenticado (no anónimo)
    function isAuthenticatedStaff() {
      return request.auth != null && 
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Colección de Camas (Estado en tiempo real de hospitalización)
    match /beds/{bedId} {
      allow read: if isAuthenticatedStaff();
      allow write: if isAuthenticatedStaff();
    }

    // Colección de Altas clínicas
    match /discharges/{dischargeId} {
      allow read: if isAuthenticatedStaff();
      allow write: if isAuthenticatedStaff();
    }

    // Colección de Traslados internos e interhospitalarios
    match /transfers/{transferId} {
      allow read: if isAuthenticatedStaff();
      allow write: if isAuthenticatedStaff();
    }

    // Colección de Procedimientos y novedades clínicas
    match /procedures/{procedureId} {
      allow read: if isAuthenticatedStaff();
      allow write: if isAuthenticatedStaff();
    }

    // Colección de Registros de Bloqueo de camas
    match /blockLogs/{logId} {
      allow read: if isAuthenticatedStaff();
      allow write: if isAuthenticatedStaff();
    }

    // Colección de Solicitudes HODOM (Hospitalización Domiciliaria)
    match /hodomRequests/{reqId} {
      allow read: if isAuthenticatedStaff();
      allow write: if isAuthenticatedStaff();
    }

    // Lista de Espera: Permite la creación tanto a funcionarios autenticados como a solicitudes remotas (/solicitud)
    // Pero bloquea la lectura y modificación a usuarios anónimos
    match /waitingList/{waitingId} {
      allow create: if request.auth != null;
      allow read: if isAuthenticatedStaff();
      allow update, delete: if isAuthenticatedStaff();
    }

    // Estado global de la aplicación (usuarios y configuraciones)
    match /appState/{docId} {
      allow read: if isAuthenticatedStaff();
      allow write: if isAuthenticatedStaff();
    }
  }
}
